# CashFlow environment variables.
# Copy this file to .env.local and fill in the values from your Supabase project.
# The anon key is safe for the browser when Row Level Security is enabled.
# Never put a service_role key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
